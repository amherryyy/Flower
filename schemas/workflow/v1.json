{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flower.dev/schemas/workflow/v1.json",
  "title": "Flower Workflow Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "description", "inputs", "steps"],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 64
    },
    "version": { "type": "integer", "minimum": 1 },
    "description": { "type": "string", "minLength": 1, "maxLength": 500 },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "required"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" },
          "type": { "enum": ["string", "number", "boolean"] },
          "required": { "type": "boolean" }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "action", "reads", "writes", "externalEffects"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
          "action": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$" },
          "reads": { "$ref": "#/$defs/paths" },
          "writes": { "$ref": "#/$defs/paths" },
          "externalEffects": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$" },
            "uniqueItems": true
          },
          "ownership": {
            "type": "object",
            "additionalProperties": false,
            "required": ["allow"],
            "properties": {
              "allow": {
                "type": "array",
                "items": { "enum": ["framework", "generated", "project", "protected", "local"] },
                "minItems": 1,
                "uniqueItems": true
              }
            }
          },
          "checks": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
            "uniqueItems": true
          }
        }
      }
    }
  },
  "$defs": {
    "paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
      },
      "uniqueItems": true
    }
  }
}
