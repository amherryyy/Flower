{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flower.dev/schemas/skill/v1.json",
  "title": "Flower Agent Skill Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "purpose",
    "entrypoint",
    "compatibleFlower",
    "adapters",
    "capabilities",
    "provenance",
    "files"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[/-][a-z0-9]+)*$", "minLength": 3, "maxLength": 100 },
    "version": { "$ref": "#/$defs/semver" },
    "purpose": { "type": "string", "minLength": 10, "maxLength": 300 },
    "entrypoint": { "$ref": "#/$defs/path" },
    "compatibleFlower": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum"],
      "properties": {
        "minimum": { "$ref": "#/$defs/semver" },
        "maximumExclusive": { "$ref": "#/$defs/semver" }
      }
    },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["codex", "claude"] }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reads", "writes", "network", "externalEffects", "approvals"],
      "properties": {
        "reads": { "$ref": "#/$defs/strings" },
        "writes": { "$ref": "#/$defs/strings" },
        "network": { "type": "boolean" },
        "externalEffects": { "$ref": "#/$defs/strings" },
        "approvals": { "$ref": "#/$defs/strings" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source", "revision", "author", "license"],
      "properties": {
        "kind": { "enum": ["first-party", "third-party"] },
        "source": { "type": "string", "minLength": 1, "maxLength": 300 },
        "revision": { "type": "string", "minLength": 1, "maxLength": 200 },
        "author": { "type": "string", "minLength": 1, "maxLength": 200 },
        "license": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "digest"],
        "properties": {
          "path": { "$ref": "#/$defs/path" },
          "bytes": { "type": "integer", "minimum": 1, "maximum": 262144 },
          "digest": { "$ref": "#/$defs/digest" }
        }
      }
    }
  },
  "$defs": {
    "semver": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "path": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" },
    "strings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 240 }
    }
  }
}
