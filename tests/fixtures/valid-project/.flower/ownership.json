{
  "version": 1,
  "rules": [
    {
      "pattern": ".flower/generated/**",
      "owner": "generated",
      "policy": "replace-if-unmodified"
    },
    {
      "pattern": "AGENTS.md",
      "owner": "generated",
      "policy": "replace-if-unmodified"
    },
    {
      "pattern": "CLAUDE.md",
      "owner": "generated",
      "policy": "replace-if-unmodified"
    },
    {
      "pattern": "docs/**",
      "owner": "project",
      "policy": "never-overwrite"
    },
    {
      "pattern": "src/domain/**",
      "owner": "project",
      "policy": "never-overwrite"
    },
    {
      "pattern": "database/migrations/flower/**",
      "owner": "protected",
      "policy": "migration-engine-only"
    },
    {
      "pattern": ".flower/cache/**",
      "owner": "local",
      "policy": "never-commit"
    }
  ]
}
