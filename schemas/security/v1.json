{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flower.dev/schemas/security/v1.json",
  "title": "Flower Security Baseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "secretScan", "dependencies", "ci", "headers", "uploads", "logging"],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "schemaVersion": { "const": 1 },
    "secretScan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxFileBytes", "exclude"],
      "properties": {
        "maxFileBytes": { "type": "integer", "minimum": 1024, "maximum": 10485760 },
        "exclude": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requireLockfile", "forbidUnpinnedTags", "forbidRemoteSources", "requireIntegrity", "allowedLicenses", "unknownLicense", "auditLevel"],
      "properties": {
        "requireLockfile": { "type": "boolean" },
        "forbidUnpinnedTags": { "type": "boolean" },
        "forbidRemoteSources": { "type": "boolean" },
        "requireIntegrity": { "type": "boolean" },
        "allowedLicenses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "unknownLicense": { "enum": ["allow", "error"] },
        "auditLevel": { "enum": ["low", "moderate", "high", "critical"] }
      }
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "include", "requireActionCommitPins", "requireReadOnlyContents", "dependencyAuditCommand"],
      "properties": {
        "enabled": { "type": "boolean" },
        "include": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "requireActionCommitPins": { "type": "boolean" },
        "requireReadOnlyContents": { "type": "boolean" },
        "dependencyAuditCommand": { "type": "string", "minLength": 1 }
      }
    },
    "headers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "file", "required", "forbiddenContentSecurityPolicyTokens"],
      "properties": {
        "enabled": { "type": "boolean" },
        "file": { "type": "string", "minLength": 1 },
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "value": { "type": "string", "minLength": 1 }
            }
          }
        },
        "forbiddenContentSecurityPolicyTokens": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "uploads": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "policyPath"],
      "properties": {
        "enabled": { "type": "boolean" },
        "policyPath": { "type": "string", "minLength": 1 }
      }
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "include", "forbidConsole", "forbiddenKeys", "redactedKeys", "allowedKeys", "maxAttributeDepth", "maxEventBytes"],
      "properties": {
        "enabled": { "type": "boolean" },
        "include": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "forbidConsole": { "type": "boolean" },
        "forbiddenKeys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" }
        },
        "redactedKeys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" }
        },
        "allowedKeys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" }
        },
        "maxAttributeDepth": { "type": "integer", "minimum": 1, "maximum": 20 },
        "maxEventBytes": { "type": "integer", "minimum": 256, "maximum": 1048576 }
      }
    }
  }
}
