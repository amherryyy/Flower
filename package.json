{
  "name": "flower-framework",
  "version": "0.1.0",
  "private": true,
  "description": "Flower framework workspace",
  "type": "module",
  "workspaces": [
    "packages/kernel",
    "packages/cli"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "typecheck": "npm run build -w @flower/kernel && npm run typecheck -w @flower/kernel && npm run typecheck -w @flower/cli",
    "test": "npm run build && vitest run",
    "flower": "node packages/cli/dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.0",
    "vitest": "^4.0.0"
  }
}
