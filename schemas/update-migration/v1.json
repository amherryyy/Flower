{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flower.dev/schemas/update-migration/v1.json",
  "title": "Flower Declarative Update Migration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operations"],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "schemaVersion": { "const": 1 },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["op", "path"],
        "properties": {
          "op": { "enum": ["set", "remove"] },
          "path": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "not": { "enum": ["__proto__", "prototype", "constructor"] }
            }
          },
          "value": {}
        }
      }
    }
  }
}
